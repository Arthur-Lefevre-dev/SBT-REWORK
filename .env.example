# Get your Steam API key from: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_api_key_here

# Optional: Faceit API key for ELO on profile pages (https://developers.faceit.com/)
FACEIT_API_KEY=your_faceit_api_key_here

# Optional: Leetify API key for CS stats on profile pages (https://leetify.com/app/developer)
LEETIFY_API_KEY=your_leetify_api_key_here

# Database: sqlite (default) or supabase
DATABASE=sqlite

# Supabase (only when DATABASE=supabase). Get from https://supabase.com/dashboard
# Run supabase/schema.sql in SQL Editor first, then: npm run migrate:sqlite-to-supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

