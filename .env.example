# Get your Steam API key from: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_api_key_here

# Optional: Decodo proxy for scraping (all Steam API + Community requests via proxy)
# Get credentials from https://decodo.com (gate.decodo.com:7000)
# DECODO_PROXY_USER=your_decodo_username
# DECODO_PROXY_PASSWORD=your_decodo_password

# Optional: Faceit API key for ELO on profile pages (https://developers.faceit.com/)
FACEIT_API_KEY=your_faceit_api_key_here

# Optional: Leetify API key for CS stats on profile pages (https://leetify.com/app/developer)
LEETIFY_API_KEY=your_leetify_api_key_here

# Database: sqlite (default) or supabase
DATABASE=sqlite

# Supabase (only when DATABASE=supabase). Run supabase/schema.sql in SQL Editor first.
# With RLS enabled, use the Secret key (backend only). Local: run `supabase status` → copy "Secret".
# New format: sb_secret_... | Legacy: JWT with role service_role.
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxx  (or your JWT service_role key)

