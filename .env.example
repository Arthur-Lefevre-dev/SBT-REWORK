# Required for scraping / vanity resolve
STEAM_API_KEY=your_api_key_here

# SQLite database file (default: ./steam-data.db)
# SQLITE_PATH=./steam-data.db

# Optional enrichment on profile pages
# FACEIT_API_KEY=
# LEETIFY_API_KEY=

# Optional Decodo proxy for Steam Community HTML only (API stays direct)
# DECODO_PROXY_USER=
# DECODO_PROXY_PASSWORD=

# Admin (Steam OpenID). SESSION_SECRET required in production (min 16 chars).
# ADMIN_STEAM_IDS=76561198011775992
# SESSION_SECRET=change-this-in-production-random-string
# Public URL for Steam redirect. In `npm run dev` defaults to http://localhost:3000
# BASE_URL=http://localhost:3000
# ENCRYPTION_KEY=optional-32-char-secret

# Optional Cloudflare Turnstile on admin login
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Auto recheck non-VAC profiles in parallel every 24h (server must stay up)
# VAC_VERIFY_AUTO=true
# VAC_VERIFY_INTERVAL_MS=86400000
# VAC_VERIFY_CONCURRENCY=2
# VAC_VERIFY_DELAY_MS=800
# VAC_VERIFY_LIMIT=0

# NODE_ENV=production
# PORT=3000
