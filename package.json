{
  "name": "steam-ban-tracker",
  "version": "2.0.0",
  "description": "Track Steam VAC / Game / Community bans via friend-network discovery",
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --clear-screen=false src/server/index.ts",
    "dev:web": "vite --port 3000 --strictPort",
    "build": "tsc -p tsconfig.server.json --noEmit && vite build",
    "start": "tsx src/server/index.ts",
    "scrape": "node --max-old-space-size=8192 --import tsx src/scraper/cli.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "tsx --test src/scraper/steam-api.test.ts src/scraper/graph.test.ts src/scraper/profile-html.test.ts src/server/ws-tokens.test.ts src/db/secrets.test.ts src/shared/async.test.ts"
  },
  "keywords": [
    "steam",
    "vac",
    "scraper",
    "ban-tracker"
  ],
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "chart.js": "^4.4.1",
    "cookie-session": "^2.1.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "express": "^4.22.1",
    "https-proxy-agent": "^7.0.6",
    "node-steam-openid": "^2.0.0",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cookie-session": "^2.0.49",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.19.12": true,
    "esbuild@0.18.20": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
