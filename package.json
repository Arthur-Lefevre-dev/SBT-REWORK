{
  "name": "steam-profile-scraper",
  "version": "1.0.0",
  "description": "Steam profile scraper - extracts profile data, bans, friends, and friendship graph statistics",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node --max-old-space-size=8192 index.js",
    "scrape": "node --max-old-space-size=8192 index.js",
    "server": "nodemon server.js",
    "dev": "concurrently \"npm run server\" \"wait-on http://localhost:3000/api/stats -t 60000 && vite\"",
    "build": "vite build && node scripts/copy-img-to-dist.cjs",
    "preview": "vite preview",
    "migrate:sqlite-to-supabase": "node scripts/migrate-sqlite-to-supabase.js"
  },
  "keywords": [
    "steam",
    "scraper",
    "steamid64",
    "friends",
    "vac-ban"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "axios": "^1.6.2",
    "better-sqlite3": "^11.6.0",
    "dotenv": "^16.3.1",
    "express": "^4.21.0",
    "express-session": "^1.18.0",
    "https-proxy-agent": "^7.0.2",
    "node-steam-openid": "^2.0.0",
    "nodemon": "^3.1.14",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "supabase": "^2.76.13",
    "vite": "^7.3.1",
    "wait-on": "^8.0.1"
  }
}
